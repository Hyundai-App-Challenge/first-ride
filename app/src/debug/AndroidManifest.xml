<?xml version="1.0" encoding="utf-8"?>
<!-- debug 전용 실측 화면과 STT 실측 퍼미션(기술 설계 13-2절). 코스의 차량 조회 퍼미션은 main에 둔다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application>
        <activity
            android:name=".measure.MeasureActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="true"
            android:label="실측" />
    </application>
</manifest>
